# These are the match stats of 5 playoff games of a specific team
# Columns represent: GOALS, FOULS, SAVES
matches_stats = [
    [2, 1, 5],
    [3, 2, 4],
    [2, 1, 6],  #I updated the goals in match 3
    [4, 3, 2],
    [3, 0, 3]
]

#Print everything and calculate for the Total & Average of each match (row) 
for i in range(len(matches_stats)):
    print("Match", i + 1, "stats:", matches_stats[i])

    total = matches_stats[i][0] + matches_stats[i][1] + matches_stats[i][2]
    average = total / 3

    print("The total stats are:", total)
    print("The average stats arw:", average)
    print()

#Max value in the data set (matches_stats) 
max_value = matches_stats[0][0]

for i in range(len(matches_stats)):
    for j in range(len(matches_stats[i])):
        if matches_stats[i][j] > max_value:
            max_value = matches_stats[i][j]

print("The max value in the data set is:", max_value)

